# FedChat Server Environment Variables

PROJECT_NAME="FedChat FL Server"
API_V1_STR="/api/v1"
SECRET_KEY="SUPER_SECRET_FEDCHAT_KEY_CHANGE_THIS_IN_PRODUCTION"

# Database & Redis Configuration
DATABASE_URL="postgresql+asyncpg://fedchat:fedchat_pass@localhost:5432/fedchat_db"
REDIS_URL="redis://localhost:6379/0"

# AWS S3 Storage Configuration
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="fedchat-models-bucket"

# Federated Learning Settings
FL_MIN_CLIENTS=3
FL_ROUNDS=10
FL_LEARNING_RATE=0.001
ROUND_TIMEOUT_SECONDS=3600

# Differential Privacy Settings
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_CLIP_NORM=1.0
